---
import MainLayout from '../../layouts/MainLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import StatCard from '../../components/ui/StatCard.astro';
---

<MainLayout title="Prospecting & VA - CRM" activeModule="crm">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Prospecting & Virtual Account</h1>
      <p class="mt-2 text-gray-600">Monitor status prospecting dan pembayaran VA</p>
    </div>
    <div class="mt-4 sm:mt-0 flex gap-3 items-center">
      <span id="lastUpdate" class="text-sm text-gray-500"></span>
      <Button variant="outline" color="crm" size="md" href="/crm">
        ← Kembali
      </Button>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8" id="statsContainer">
    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-yellow-500">
      <p class="text-sm text-gray-500">Closing</p>
      <p class="text-2xl font-bold text-yellow-600" id="statClosing">-</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-green-500">
      <p class="text-sm text-gray-500">Closed (Paid)</p>
      <p class="text-2xl font-bold text-green-600" id="statClosed">-</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-blue-500">
      <p class="text-sm text-gray-500">VA Active</p>
      <p class="text-2xl font-bold text-blue-600" id="statVaActive">-</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-emerald-500">
      <p class="text-sm text-gray-500">Total Revenue</p>
      <p class="text-xl font-bold text-emerald-600" id="statRevenue">-</p>
    </div>
  </div>

  <!-- Auto-refresh indicator -->
  <div class="mb-4 flex items-center gap-3">
    <div class="flex items-center gap-2">
      <span id="refreshIndicator" class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
      <span class="text-sm text-gray-500">Auto-refresh setiap 5 detik</span>
    </div>
    <button
      id="refreshBtn"
      class="px-3 py-1 text-sm bg-crm-100 text-crm-700 rounded-lg hover:bg-crm-200 transition"
    >
      Refresh Sekarang
    </button>
  </div>

  <Card title="Daftar Prospecting" color="crm">
    <div class="mb-6 flex flex-col md:flex-row gap-4">
      <div class="flex-1">
        <input
          type="text"
          id="searchInput"
          placeholder="Cari nama customer..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crm-500 focus:border-crm-500"
        />
      </div>
      <select id="statusFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crm-500">
        <option value="">Semua Status</option>
        <option value="Closing">Closing</option>
        <option value="Closed">Closed</option>
      </select>
      <select id="vaFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crm-500">
        <option value="">Semua VA</option>
        <option value="ACTIVE">VA Active</option>
        <option value="PAID">VA Paid</option>
        <option value="none">Belum Ada VA</option>
      </select>
    </div>

    <div class="overflow-x-auto max-h-[500px] overflow-y-auto">
      <table class="min-w-full divide-y divide-gray-200" id="prospectingsTable">
        <thead class="bg-crm-50 sticky top-0">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">Customer</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">Unit Bisnis</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-crm-700 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">VA Number</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-crm-700 uppercase">Amount</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-crm-700 uppercase">VA Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">Paid At</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" id="tableBody">
          <tr>
            <td colspan="8" class="px-4 py-8 text-center text-gray-500">
              Loading...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex justify-between items-center text-sm text-gray-500 pt-4 border-t">
      <span id="resultCount">Menampilkan 0 prospecting</span>
    </div>
  </Card>

  <!-- Legend -->
  <div class="mt-6 p-4 bg-gray-50 rounded-lg">
    <h3 class="font-semibold text-gray-700 mb-2">Status Legend:</h3>
    <div class="flex flex-wrap gap-4 text-sm">
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-yellow-100 text-yellow-800">Closing</span>
        <span class="text-gray-500">Menunggu pembayaran</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-green-100 text-green-800">Closed</span>
        <span class="text-gray-500">Sudah dibayar (auto dari app-bca)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-blue-100 text-blue-800">ACTIVE</span>
        <span class="text-gray-500">VA menunggu bayar</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-emerald-100 text-emerald-800">PAID</span>
        <span class="text-gray-500">VA sudah dibayar</span>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  // Use production API URLs
  const API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:3001'
    : 'https://pklproject-backend.up.railway.app';

  let prospectingsData = [];

  // Format currency
  function formatCurrency(amount) {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0
    }).format(amount);
  }

  // Format date
  function formatDate(dateStr) {
    if (!dateStr) return '-';
    return new Date(dateStr).toLocaleString('id-ID', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  // Get status badge class
  function getStatusBadge(status) {
    switch (status) {
      case 'Closing':
        return 'bg-yellow-100 text-yellow-800';
      case 'Closed':
        return 'bg-green-100 text-green-800';
      default:
        return 'bg-gray-100 text-gray-800';
    }
  }

  // Get VA status badge class
  function getVaStatusBadge(status) {
    switch (status) {
      case 'ACTIVE':
        return 'bg-blue-100 text-blue-800';
      case 'PAID':
        return 'bg-emerald-100 text-emerald-800';
      case 'EXPIRED':
        return 'bg-gray-100 text-gray-800';
      default:
        return 'bg-gray-50 text-gray-400';
    }
  }

  // Render table
  function renderTable(data) {
    const tableBody = document.getElementById('tableBody');
    const resultCount = document.getElementById('resultCount');

    if (!tableBody) return;

    if (data.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="8" class="px-4 py-8 text-center text-gray-500">
            Tidak ada data prospecting
          </td>
        </tr>
      `;
      if (resultCount) resultCount.textContent = 'Menampilkan 0 prospecting';
      return;
    }

    tableBody.innerHTML = data.map(p => `
      <tr class="hover:bg-crm-50 prospecting-row transition-colors"
          data-name="${(p.kontak_nama || '').toLowerCase()}"
          data-status="${p.status || ''}"
          data-va-status="${p.va_status || 'none'}">
        <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-900">
          #${p.id}
        </td>
        <td class="px-4 py-3 text-sm text-gray-900">
          <div>
            <p class="font-semibold">${p.kontak_nama || '-'}</p>
            <p class="text-xs text-gray-500">${p.kontak_telepon || '-'}</p>
          </div>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
          ${p.unit_bisnis || '-'}
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-center">
          <span class="px-2 py-1 text-xs font-semibold rounded-full ${getStatusBadge(p.status)}">
            ${p.status || '-'}
          </span>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-600">
          ${p.va_number || '-'}
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-sm text-right font-semibold text-gray-900">
          ${p.amount ? formatCurrency(p.amount) : '-'}
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-center">
          <span class="px-2 py-1 text-xs font-semibold rounded-full ${getVaStatusBadge(p.va_status)}">
            ${p.va_status || 'No VA'}
          </span>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">
          ${formatDate(p.paid_at)}
        </td>
      </tr>
    `).join('');

    if (resultCount) {
      resultCount.textContent = `Menampilkan ${data.length} prospecting`;
    }
  }

  // Update stats
  function updateStats(stats) {
    const statClosing = document.getElementById('statClosing');
    const statClosed = document.getElementById('statClosed');
    const statVaActive = document.getElementById('statVaActive');
    const statRevenue = document.getElementById('statRevenue');

    if (stats.prospecting) {
      if (statClosing) statClosing.textContent = stats.prospecting.closing || '0';
      if (statClosed) statClosed.textContent = stats.prospecting.closed || '0';
    }
    if (stats.va) {
      if (statVaActive) statVaActive.textContent = stats.va.active_va || '0';
      if (statRevenue) statRevenue.textContent = formatCurrency(stats.va.total_revenue || 0);
    }
  }

  // Filter rows
  function filterRows() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const vaFilter = document.getElementById('vaFilter');

    const searchTerm = searchInput?.value.toLowerCase() || '';
    const statusValue = statusFilter?.value || '';
    const vaValue = vaFilter?.value || '';

    const filtered = prospectingsData.filter(p => {
      const matchesSearch = !searchTerm || (p.kontak_nama || '').toLowerCase().includes(searchTerm);
      const matchesStatus = !statusValue || p.status === statusValue;
      const matchesVa = !vaValue ||
        (vaValue === 'none' && !p.va_status) ||
        (vaValue !== 'none' && p.va_status === vaValue);

      return matchesSearch && matchesStatus && matchesVa;
    });

    renderTable(filtered);
  }

  // Fetch data
  async function fetchData() {
    try {
      // Fetch prospectings
      const response = await fetch(`${API_BASE}/prospectings`);
      const result = await response.json();

      if (result.success) {
        prospectingsData = result.data;
        filterRows();
      }

      // Fetch stats
      const statsResponse = await fetch(`${API_BASE}/prospectings/stats`);
      const statsResult = await statsResponse.json();

      if (statsResult.success) {
        updateStats(statsResult.data);
      }

      // Update last refresh time
      const lastUpdate = document.getElementById('lastUpdate');
      if (lastUpdate) {
        lastUpdate.textContent = `Updated: ${new Date().toLocaleTimeString('id-ID')}`;
      }
    } catch (err) {
      console.error('Failed to fetch data:', err);
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    // Initial fetch
    fetchData();

    // Auto-refresh every 5 seconds
    setInterval(fetchData, 5000);

    // Manual refresh button
    const refreshBtn = document.getElementById('refreshBtn');
    refreshBtn?.addEventListener('click', fetchData);

    // Filter listeners
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const vaFilter = document.getElementById('vaFilter');

    searchInput?.addEventListener('input', filterRows);
    statusFilter?.addEventListener('change', filterRows);
    vaFilter?.addEventListener('change', filterRows);
  });
</script>

<style>
  .prospecting-row {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; background-color: #fef3c7; }
    to { opacity: 1; background-color: transparent; }
  }
</style>
