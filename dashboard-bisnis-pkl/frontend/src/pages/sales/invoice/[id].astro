---
import MainLayout from '../../../layouts/MainLayout.astro';
import Card from '../../../components/ui/Card.astro';
import Button from '../../../components/ui/Button.astro';
import { api } from '../../../lib/api';

const { id } = Astro.params;

const transactionResponse = await api.get(`/transactions/${id}`);
const transaction = transactionResponse.success ? transactionResponse.data : null;

if (!transaction) {
  return Astro.redirect('/sales/transactions');
}

// Parse items - handle both string and array
let items: any[] = [];
if (transaction.items) {
  if (typeof transaction.items === 'string') {
    try {
      items = JSON.parse(transaction.items);
    } catch (e) {
      items = [];
    }
  } else if (Array.isArray(transaction.items)) {
    items = transaction.items;
  }
}

function formatCurrency(amount: number | string): string {
  const num = Math.round(Number(amount) || 0);
  return `Rp ${num.toLocaleString('id-ID')}`;
}

function formatDate(date: string): string {
  return new Date(date).toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
}

// Use PUBLIC_SITE_URL for share link
// In production (Railway), use RAILWAY_PUBLIC_DOMAIN or PUBLIC_SITE_URL
const siteUrl = import.meta.env.PUBLIC_SITE_URL ||
                (import.meta.env.RAILWAY_PUBLIC_DOMAIN ? `https://${import.meta.env.RAILWAY_PUBLIC_DOMAIN}` : null) ||
                Astro.url.origin;
const invoiceUrl = `${siteUrl}/sales/invoice/${id}`;
const promoType = transaction.notes?.includes('Promo:') ? transaction.notes.replace('Promo: ', '') : null;
---

<MainLayout title={`Invoice ${transaction.reference_number || id} - Penjualan`} activeModule="sales">
  <div class="max-w-4xl mx-auto">
    <!-- Page Header -->
    <div class="mb-6 print:hidden">
      <div class="flex items-center space-x-2 text-sm text-gray-500 mb-2">
        <a href="/sales" class="hover:text-sales-600">Penjualan</a>
        <span>/</span>
        <a href="/sales/transactions" class="hover:text-sales-600">Transaksi</a>
        <span>/</span>
        <span>Invoice #{transaction.reference_number || id}</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Detail Invoice</h1>
          <p class="mt-1 text-gray-600">{transaction.reference_number || `INV-${id}`}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <Button variant="outline" color="sales" size="md" href="/sales/transactions">
            ← Kembali
          </Button>
          <button onclick="printInvoice()" class="px-4 py-2 bg-sales-500 text-white rounded-lg hover:bg-sales-600 transition-colors inline-flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Cetak PDF
          </button>
          <button onclick="shareInvoice()" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors inline-flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            Bagikan
          </button>
        </div>
      </div>
    </div>

    <!-- Invoice Document -->
    <div id="invoiceContent" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sm:p-8 print:shadow-none print:border-0 print:p-0">
      <!-- Invoice Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-8 border-b pb-6">
        <div>
          <h2 class="text-2xl font-bold text-sales-600">INVOICE</h2>
          <p class="text-lg font-semibold text-gray-900 mt-1">{transaction.reference_number || `INV-${String(id).padStart(6, '0')}`}</p>
        </div>
        <div class="text-right">
          <h3 class="text-xl font-bold text-gray-900">Dashboard Bisnis</h3>
          <p class="text-sm text-gray-600">Sistem Manajemen Penjualan</p>
        </div>
      </div>

      <!-- Invoice Info -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        <div>
          <h4 class="text-sm font-semibold text-gray-500 uppercase mb-2">Ditagihkan Kepada</h4>
          <p class="font-semibold text-gray-900">{transaction.customer_name || 'Walk-in Customer'}</p>
          {transaction.customer_phone && (
            <p class="text-sm text-gray-600">{transaction.customer_phone}</p>
          )}
          {transaction.customer_address && (
            <p class="text-sm text-gray-600">{transaction.customer_address}</p>
          )}
        </div>
        <div class="sm:text-right">
          <div class="space-y-1">
            <p class="text-sm">
              <span class="text-gray-500">Tanggal:</span>
              <span class="font-medium text-gray-900 ml-2">{formatDate(transaction.transaction_date)}</span>
            </p>
            <p class="text-sm">
              <span class="text-gray-500">Metode Pembayaran:</span>
              <span class="font-medium text-gray-900 ml-2">
                {transaction.payment_method === 'CASH' ? 'Tunai' :
                 transaction.payment_method === 'BANK_TRANSFER' ? 'Transfer Bank' : 'Lainnya'}
              </span>
            </p>
            <p class="text-sm">
              <span class="text-gray-500">Status:</span>
              <span class={`ml-2 px-2 py-0.5 text-xs font-semibold rounded-full ${
                transaction.payment_status === 'PAID' ? 'bg-green-100 text-green-800' :
                transaction.payment_status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' :
                'bg-gray-100 text-gray-800'
              }`}>
                {transaction.payment_status === 'PAID' ? 'LUNAS' :
                 transaction.payment_status === 'PENDING' ? 'PENDING' : transaction.payment_status}
              </span>
            </p>
            {transaction.pic && (
              <p class="text-sm">
                <span class="text-gray-500">Sales:</span>
                <span class="font-medium text-gray-900 ml-2">{transaction.pic}</span>
              </p>
            )}
            {promoType && (
              <p class="text-sm">
                <span class="text-gray-500">Tipe Promo:</span>
                <span class="font-medium text-sales-600 ml-2">{promoType}</span>
              </p>
            )}
          </div>
        </div>
      </div>

      <!-- Items Table -->
      <div class="border rounded-lg overflow-hidden mb-6">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">No</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Item</th>
              <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase">Qty</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Harga</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase">Subtotal</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {items.length > 0 ? items.map((item: any, index: number) => (
              <tr>
                <td class="px-4 py-3 text-sm text-gray-600">{index + 1}</td>
                <td class="px-4 py-3">
                  <p class="text-sm font-medium text-gray-900">{item.name || 'Produk'}</p>
                  {(item.color || item.size) && (
                    <p class="text-xs text-gray-500">
                      {item.color}{item.color && item.size ? ' / ' : ''}{item.size}
                    </p>
                  )}
                </td>
                <td class="px-4 py-3 text-sm text-center text-gray-900">{item.quantity || 1}</td>
                <td class="px-4 py-3 text-sm text-right text-gray-900">{formatCurrency(item.price || 0)}</td>
                <td class="px-4 py-3 text-sm text-right font-medium text-gray-900">
                  {formatCurrency((item.quantity || 1) * (item.price || 0))}
                </td>
              </tr>
            )) : (
              <tr>
                <td colspan="5" class="px-4 py-8 text-center text-gray-500">
                  Tidak ada item
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <!-- Total Section -->
      <div class="flex justify-end">
        <div class="w-full sm:w-64">
          <div class="flex justify-between py-2 border-b">
            <span class="text-gray-600">Subtotal</span>
            <span class="font-medium text-gray-900">{formatCurrency(transaction.total_amount)}</span>
          </div>
          <div class="flex justify-between py-2 border-b">
            <span class="text-gray-600">Diskon</span>
            <span class="font-medium text-gray-900">Rp 0</span>
          </div>
          <div class="flex justify-between py-3 text-lg font-bold">
            <span class="text-gray-900">TOTAL</span>
            <span class="text-sales-600">{formatCurrency(transaction.total_amount)}</span>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="mt-8 pt-6 border-t">
        <div class="text-center text-sm text-gray-500">
          <p>Terima kasih atas kepercayaan Anda!</p>
          <p class="mt-1">Invoice ini sah dan diproses oleh sistem.</p>
          <p class="mt-2 text-xs">Dicetak pada: {new Date().toLocaleString('id-ID')}</p>
        </div>
      </div>
    </div>

    <!-- Share Modal -->
    <div id="shareModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
      <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Bagikan Invoice</h3>
            <button onclick="closeShareModal()" class="text-gray-400 hover:text-gray-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Link Invoice</label>
            <div class="flex">
              <input
                type="text"
                id="shareUrl"
                readonly
                class="flex-1 px-4 py-2 border border-gray-300 rounded-l-lg bg-gray-50 text-sm"
              />
              <button
                onclick="copyLink()"
                class="px-4 py-2 bg-sales-500 text-white rounded-r-lg hover:bg-sales-600 transition-colors"
              >
                Salin
              </button>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <button onclick="shareVia('whatsapp')" class="flex flex-col items-center p-3 border rounded-lg hover:bg-green-50 hover:border-green-300 transition-colors">
              <svg class="w-8 h-8 text-green-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span class="text-xs mt-1 text-gray-600">WhatsApp</span>
            </button>
            <button onclick="shareVia('email')" class="flex flex-col items-center p-3 border rounded-lg hover:bg-blue-50 hover:border-blue-300 transition-colors">
              <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="text-xs mt-1 text-gray-600">Email</span>
            </button>
            <button onclick="shareVia('telegram')" class="flex flex-col items-center p-3 border rounded-lg hover:bg-sky-50 hover:border-sky-300 transition-colors">
              <svg class="w-8 h-8 text-sky-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              <span class="text-xs mt-1 text-gray-600">Telegram</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  @media print {
    /* Hide everything except invoice */
    body {
      background: white !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    /* Hide sidebar, navbar, footer */
    nav, aside, footer,
    [class*="sidebar"],
    [class*="navbar"],
    [class*="Sidebar"],
    [class*="Navbar"],
    [class*="Footer"] {
      display: none !important;
    }

    /* Remove main content margin/padding from sidebar */
    main {
      margin-left: 0 !important;
      padding: 0 !important;
    }

    /* Print utilities */
    .print\:hidden { display: none !important; }
    .print\:shadow-none { box-shadow: none !important; }
    .print\:border-0 { border: none !important; }
    .print\:p-0 { padding: 0 !important; }

    /* Make invoice full width */
    #invoiceContent {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 20px !important;
      box-shadow: none !important;
      border: none !important;
    }

    /* Hide share modal */
    #shareModal { display: none !important; }
  }

  @page {
    size: A4;
    margin: 10mm;
  }
</style>

<script define:vars={{ invoiceUrl }}>
  window.printInvoice = function() {
    // Create a new window with only invoice content
    const invoiceContent = document.getElementById('invoiceContent');
    if (!invoiceContent) return;

    const printWindow = window.open('', '_blank', 'width=800,height=600');
    printWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Invoice</title>
        <style>
          * { margin: 0; padding: 0; box-sizing: border-box; }
          body { font-family: system-ui, -apple-system, sans-serif; padding: 20px; background: white; }
          table { width: 100%; border-collapse: collapse; }
          th, td { padding: 8px 12px; text-align: left; }
          thead { background: #f9fafb; }
          tbody tr { border-bottom: 1px solid #e5e7eb; }
          .text-right { text-align: right; }
          .text-center { text-align: center; }
          .font-bold { font-weight: 700; }
          .font-semibold { font-weight: 600; }
          .font-medium { font-weight: 500; }
          .text-sm { font-size: 14px; }
          .text-xs { font-size: 12px; }
          .text-lg { font-size: 18px; }
          .text-2xl { font-size: 24px; }
          .text-gray-500 { color: #6b7280; }
          .text-gray-600 { color: #4b5563; }
          .text-gray-900 { color: #111827; }
          .mb-2 { margin-bottom: 8px; }
          .mb-4 { margin-bottom: 16px; }
          .mb-6 { margin-bottom: 24px; }
          .mb-8 { margin-bottom: 32px; }
          .mt-1 { margin-top: 4px; }
          .mt-8 { margin-top: 32px; }
          .pt-6 { padding-top: 24px; }
          .pb-6 { padding-bottom: 24px; }
          .py-2 { padding-top: 8px; padding-bottom: 8px; }
          .py-3 { padding-top: 12px; padding-bottom: 12px; }
          .px-2 { padding-left: 8px; padding-right: 8px; }
          .border-b { border-bottom: 1px solid #e5e7eb; }
          .border-t { border-top: 1px solid #e5e7eb; }
          .border { border: 1px solid #e5e7eb; }
          .rounded-lg { border-radius: 8px; }
          .rounded-full { border-radius: 9999px; }
          .overflow-hidden { overflow: hidden; }
          .flex { display: flex; }
          .justify-between { justify-content: space-between; }
          .justify-end { justify-content: flex-end; }
          .items-start { align-items: flex-start; }
          .grid { display: grid; }
          .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
          .gap-6 { gap: 24px; }
          .space-y-1 > * + * { margin-top: 4px; }
          .bg-green-100 { background: #dcfce7; }
          .text-green-800 { color: #166534; }
          .bg-yellow-100 { background: #fef9c3; }
          .text-yellow-800 { color: #854d0e; }
          .text-sales-600 { color: #2563eb; }
          .w-64 { width: 256px; }
          @media print {
            body { padding: 0; }
            @page { size: A4; margin: 10mm; }
          }
        </style>
      </head>
      <body>
        ${invoiceContent.innerHTML}
        <script>
          window.onload = function() {
            window.print();
            window.onafterprint = function() { window.close(); };
          };
        <\/script>
      </body>
      </html>
    `);
    printWindow.document.close();
  };

  window.shareInvoice = function() {
    const modal = document.getElementById('shareModal');
    const urlInput = document.getElementById('shareUrl');
    if (modal) {
      modal.classList.remove('hidden');
    }
    if (urlInput) {
      urlInput.value = invoiceUrl;
    }
  };

  window.closeShareModal = function() {
    const modal = document.getElementById('shareModal');
    if (modal) {
      modal.classList.add('hidden');
    }
  };

  window.copyLink = function() {
    const urlInput = document.getElementById('shareUrl');
    if (urlInput) {
      urlInput.select();
      document.execCommand('copy');
      alert('Link berhasil disalin!');
    }
  };

  window.shareVia = function(platform) {
    const text = encodeURIComponent('Invoice Penjualan');
    const url = encodeURIComponent(invoiceUrl);

    let shareUrl = '';
    switch (platform) {
      case 'whatsapp':
        shareUrl = `https://wa.me/?text=${text}%20${url}`;
        break;
      case 'email':
        shareUrl = `mailto:?subject=${text}&body=Lihat invoice di: ${url}`;
        break;
      case 'telegram':
        shareUrl = `https://t.me/share/url?url=${url}&text=${text}`;
        break;
    }

    if (shareUrl) {
      window.open(shareUrl, '_blank');
    }
  };

  // Close modal when clicking outside
  document.getElementById('shareModal')?.addEventListener('click', (e) => {
    if (e.target.id === 'shareModal') {
      window.closeShareModal();
    }
  });
</script>
