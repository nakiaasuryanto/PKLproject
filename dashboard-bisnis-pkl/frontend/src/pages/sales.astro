---
import MainLayout from '../layouts/MainLayout.astro';
import Card from '../components/ui/Card.astro';
import StatCard from '../components/ui/StatCard.astro';
import Button from '../components/ui/Button.astro';
import ChartWrapper from '../components/charts/ChartWrapper.astro';
import { api } from '../lib/api';

// Fetch sales data from backend API
const salesStatsResponse = await api.get('/transactions/stats/summary?start_date=2025-01-01');
const salesTrendResponse = await api.get('/dashboard/sales-trend?period=daily&limit=30');
const recentTransactionsResponse = await api.get('/transactions?type=SALE&limit=10');
const paymentMethodsResponse = await api.get('/dashboard/payment-methods');

const stats = (salesStatsResponse.success && Array.isArray(salesStatsResponse.data)) ? salesStatsResponse.data : [];
const trend = (salesTrendResponse.success && Array.isArray(salesTrendResponse.data)) ? salesTrendResponse.data : [];
const transactions = (recentTransactionsResponse.success && Array.isArray(recentTransactionsResponse.data)) ? recentTransactionsResponse.data : [];
const paymentMethods = (paymentMethodsResponse.success && Array.isArray(paymentMethodsResponse.data)) ? paymentMethodsResponse.data : [];

// Calculate metrics from API data (convert to integer to remove decimals)
const saleStats = Array.isArray(stats) ? stats.find((s: any) => s.transaction_type === 'SALE') || { total: 0, count: 0 } : { total: 0, count: 0 };
const totalSales = Math.round(Number(saleStats.total) || 0);
const salesCount = Number(saleStats.count) || 0;
const avgPerTransaction = salesCount > 0 ? Math.round(totalSales / salesCount) : 0;

// Format currency with Indonesian thousand separators
function formatCurrency(amount: number | string): string {
  const num = Math.round(Number(amount) || 0);
  return `Rp ${num.toLocaleString('id-ID')}`;
}
---

<MainLayout title="Penjualan - Dashboard Bisnis" activeModule="sales">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Dashboard Penjualan</h1>
      <p class="mt-2 text-gray-600">Monitor performa penjualan dan transaksi</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <Button variant="primary" color="sales" size="lg" href="/sales/invoice/new">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Buat Invoice Baru
      </Button>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-8">
    <StatCard
      title="Total Penjualan"
      value={formatCurrency(totalSales)}
      change={totalSales > 0 ? "Data tersedia" : "Belum ada data"}
      changeType={totalSales > 0 ? "positive" : "neutral"}
      color="sales"
      icon="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
    />
    <StatCard
      title="Jumlah Transaksi"
      value={salesCount}
      change={salesCount > 0 ? `${salesCount} transaksi` : "Belum ada transaksi"}
      changeType={salesCount > 0 ? "positive" : "neutral"}
      color="sales"
      icon="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
    />
    <StatCard
      title="Rata-rata per Transaksi"
      value={avgPerTransaction > 0 ? formatCurrency(avgPerTransaction) : "Rp 0"}
      change={avgPerTransaction > 0 ? "Rata-rata tersedia" : "Belum ada data"}
      changeType="neutral"
      color="sales"
      icon="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
    />
  </div>

  <!-- Charts Row -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Sales Trend Chart -->
    <Card title="Tren Penjualan (30 Hari)" color="sales">
      <ChartWrapper chartId="salesTrendChart" height="300px" />
    </Card>

    <!-- Sales by Payment Method -->
    <Card title="Metode Pembayaran" color="sales">
      <ChartWrapper chartId="paymentMethodChart" height="300px" />
    </Card>
  </div>

  <!-- Recent Transactions Table -->
  <Card title="Transaksi Terbaru" color="sales" className="overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="text-xs uppercase bg-sales-50 text-sales-700">
          <tr>
            <th class="px-6 py-3">Tanggal</th>
            <th class="px-6 py-3">Customer</th>
            <th class="px-6 py-3">Total</th>
            <th class="px-6 py-3">Pembayaran</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          {transactions.length > 0 ? transactions.map((tx: any) => (
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                {new Date(tx.transaction_date).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric'
                })}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                {tx.customer_name || 'Walk-in Customer'}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-sales-600">
                {formatCurrency(tx.total_amount)}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                {tx.payment_method || '-'}
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                  tx.payment_status === 'COMPLETED' || tx.payment_status === 'PAID'
                    ? 'bg-green-100 text-green-800'
                    : tx.payment_status === 'PENDING'
                    ? 'bg-yellow-100 text-yellow-800'
                    : 'bg-gray-100 text-gray-800'
                }`}>
                  {tx.payment_status || 'N/A'}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center">
                <a
                  href={`/sales/invoice/${tx.id}`}
                  class="inline-flex items-center px-2 py-1 text-xs font-medium text-sales-600 hover:text-sales-800 transition-colors"
                >
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  Lihat
                </a>
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p>Belum ada data transaksi</p>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    {transactions.length > 0 && (
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t">
        <p id="paginationInfo" class="text-sm text-gray-600">
          Menampilkan 1-{Math.min(10, transactions.length)} dari {transactions.length} transaksi
        </p>
        <div class="flex items-center gap-2">
          <button id="prevBtn" class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
            ← Sebelumnya
          </button>
          <span id="pageInfo" class="px-3 py-1.5 text-sm text-gray-600">1 / {Math.ceil(transactions.length / 10)}</span>
          <button id="nextBtn" class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
            Selanjutnya →
          </button>
        </div>
        <a href="/sales/transactions" class="text-sm font-medium text-sales-600 hover:text-sales-700 inline-flex items-center">
          Lihat Semua
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    )}
  </Card>
</MainLayout>

<script is:inline define:vars={{ trendData: trend, paymentMethodsData: paymentMethods, totalTransactions: transactions.length }}>
  window.salesTrendData = trendData;
  window.paymentMethodsData = paymentMethodsData;

  // Pagination
  const ITEMS_PER_PAGE = 10;
  let currentPage = 1;
  const totalPages = Math.ceil(totalTransactions / ITEMS_PER_PAGE);

  document.addEventListener('DOMContentLoaded', () => {
    const tbody = document.querySelector('tbody.divide-y');
    const rows = tbody ? Array.from(tbody.querySelectorAll('tr')) : [];
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const pageInfo = document.getElementById('pageInfo');
    const paginationInfo = document.getElementById('paginationInfo');

    function showPage(page) {
      const start = (page - 1) * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;

      rows.forEach((row, index) => {
        row.style.display = index >= start && index < end ? '' : 'none';
      });

      if (pageInfo) pageInfo.textContent = `${page} / ${totalPages}`;
      if (paginationInfo) {
        const showStart = start + 1;
        const showEnd = Math.min(end, totalTransactions);
        paginationInfo.textContent = `Menampilkan ${showStart}-${showEnd} dari ${totalTransactions} transaksi`;
      }
      if (prevBtn) prevBtn.disabled = page <= 1;
      if (nextBtn) nextBtn.disabled = page >= totalPages;
    }

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        showPage(currentPage);
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        showPage(currentPage);
      }
    });

    // Initial display
    if (rows.length > 0) showPage(1);
  });
</script>

<script>
  import { createLineChart, createDoughnutChart } from '../lib/chartUtils';

  const PAYMENT_METHOD_LABELS = {
    'CASH': 'Tunai',
    'BANK_TRANSFER': 'Transfer Bank',
    'OTHER': 'Lainnya'
  };

  document.addEventListener('DOMContentLoaded', () => {
    const trendData = window.salesTrendData || [];
    const paymentMethodsData = window.paymentMethodsData || [];

    // Sales Trend Chart
    if (trendData.length > 0) {
      const labels = trendData.map(d => {
        const date = new Date(d.period);
        return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
      });
      const salesData = trendData.map(d => d.sales || 0);

      createLineChart('salesTrendChart', labels, [
        {
          label: 'Penjualan',
          data: salesData,
          borderColor: '#EF4444',
          backgroundColor: 'rgba(239, 68, 68, 0.1)',
          tension: 0.4,
          fill: true
        }
      ]);
    } else {
      createLineChart('salesTrendChart',
        ['Belum Ada Data'],
        [{
          label: 'Penjualan',
          data: [0],
          borderColor: '#E5E7EB',
          backgroundColor: 'rgba(229, 231, 235, 0.1)',
          tension: 0.4,
          fill: true
        }]
      );
    }

    // Payment Method Chart
    if (paymentMethodsData.length > 0) {
      const labels = paymentMethodsData.map(d => PAYMENT_METHOD_LABELS[d.payment_method] || d.payment_method);
      const data = paymentMethodsData.map(d => d.count);

      createDoughnutChart(
        'paymentMethodChart',
        labels,
        data,
        ['#EF4444', '#F87171', '#FCA5A5', '#FECACA']
      );
    } else {
      createDoughnutChart(
        'paymentMethodChart',
        ['Belum Ada Data'],
        [1],
        ['#E5E7EB']
      );
    }
  });
</script>
