---
import MainLayout from '../layouts/MainLayout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:3001/api';
---

<MainLayout title="Akun Saya - Dashboard Bisnis" activeModule="">
  <div class="max-w-4xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Akun Saya</h1>
      <p class="mt-2 text-gray-600">Kelola profil dan pengajuan izin</p>
    </div>

    <!-- Profile Card -->
    <Card title="Biodata" color="primary" className="mb-8">
      <div id="profileLoading" class="text-center py-8">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
        <p class="mt-2 text-gray-500">Memuat data...</p>
      </div>

      <form id="profileForm" class="hidden">
        <div class="flex items-center space-x-4 mb-6 pb-6 border-b">
          <div id="avatarInitials" class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center text-2xl font-bold text-blue-600">
            --
          </div>
          <div>
            <h2 id="displayName" class="text-xl font-semibold text-gray-900">-</h2>
            <p id="displayPosition" class="text-gray-600">-</p>
            <p id="displayDepartment" class="text-sm text-gray-500">-</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Nama Lengkap</label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Telepon</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Lahir</label>
            <input
              type="date"
              id="birth_date"
              name="birth_date"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-2">Alamat</label>
            <textarea
              id="address"
              name="address"
              rows="2"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            ></textarea>
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-2">Bio</label>
            <textarea
              id="bio"
              name="bio"
              rows="3"
              placeholder="Ceritakan sedikit tentang diri Anda..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            ></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Kontak Darurat</label>
            <input
              type="text"
              id="emergency_contact"
              name="emergency_contact"
              placeholder="Nama kontak darurat"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Telepon Darurat</label>
            <input
              type="tel"
              id="emergency_phone"
              name="emergency_phone"
              placeholder="08xxxxxxxxxx"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
        </div>

        <div class="mt-6 pt-6 border-t flex justify-end">
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            Simpan Perubahan
          </button>
        </div>
      </form>
    </Card>

    <!-- Leave Request Card -->
    <Card title="Pengajuan Izin" color="primary" className="mb-8">
      <form id="leaveForm" class="space-y-4 mb-6 pb-6 border-b">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Jenis Izin</label>
            <select
              id="leave_type"
              name="leave_type"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            >
              <option value="SICK">Sakit</option>
              <option value="ANNUAL">Cuti Tahunan</option>
              <option value="PERSONAL">Keperluan Pribadi</option>
              <option value="OTHER">Lainnya</option>
            </select>
          </div>
          <div></div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Mulai</label>
            <input
              type="date"
              id="start_date"
              name="start_date"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal Selesai</label>
            <input
              type="date"
              id="end_date"
              name="end_date"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-2">Alasan</label>
            <textarea
              id="reason"
              name="reason"
              rows="2"
              required
              placeholder="Jelaskan alasan izin Anda..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            ></textarea>
          </div>
        </div>
        <div class="flex justify-end">
          <button
            type="submit"
            class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium"
          >
            Ajukan Izin
          </button>
        </div>
      </form>

      <!-- Leave Request History -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Riwayat Pengajuan</h3>
        <div id="leaveHistory" class="space-y-3">
          <div class="text-center py-4 text-gray-500">
            <p>Memuat riwayat...</p>
          </div>
        </div>
      </div>
    </Card>

    <!-- Work Info Card -->
    <Card title="Informasi Kerja" color="primary">
      <div id="workInfo" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-600 mb-1">Kode Karyawan</p>
          <p id="employeeCode" class="text-xl font-bold text-gray-900">-</p>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-600 mb-1">Tanggal Bergabung</p>
          <p id="hireDate" class="text-xl font-bold text-gray-900">-</p>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-600 mb-1">Status</p>
          <p id="employeeStatus" class="text-xl font-bold text-green-600">-</p>
        </div>
      </div>
    </Card>
  </div>
</MainLayout>

<script define:vars={{ API_BASE }}>
  let currentUser = null;
  let employeeData = null;

  document.addEventListener('DOMContentLoaded', async () => {
    // Get user from localStorage
    try {
      const userStr = localStorage.getItem('user');
      if (userStr) {
        currentUser = JSON.parse(userStr);
        await loadEmployeeData();
        await loadLeaveHistory();
      } else {
        showError('Silakan login terlebih dahulu');
      }
    } catch (e) {
      console.error('Error loading user:', e);
      showError('Gagal memuat data pengguna');
    }
  });

  async function loadEmployeeData() {
    const profileLoading = document.getElementById('profileLoading');
    const profileForm = document.getElementById('profileForm');

    if (!currentUser?.employee_id) {
      profileLoading.innerHTML = '<p class="text-gray-500">Data karyawan tidak tersedia</p>';
      return;
    }

    try {
      const response = await fetch(`${API_BASE}/employees/${currentUser.employee_id}`);
      const result = await response.json();

      if (result.success && result.data) {
        employeeData = result.data;
        populateForm(employeeData);
        profileLoading.classList.add('hidden');
        profileForm.classList.remove('hidden');
      } else {
        profileLoading.innerHTML = '<p class="text-red-500">Gagal memuat data</p>';
      }
    } catch (error) {
      console.error('Error loading employee data:', error);
      profileLoading.innerHTML = '<p class="text-red-500">Terjadi kesalahan</p>';
    }
  }

  function populateForm(data) {
    // Avatar initials
    const initials = data.name?.split(' ').map(n => n[0]).join('').slice(0, 2) || '--';
    document.getElementById('avatarInitials').textContent = initials;

    // Display info
    document.getElementById('displayName').textContent = data.name || '-';
    document.getElementById('displayPosition').textContent = data.position || '-';
    document.getElementById('displayDepartment').textContent = data.department || '-';

    // Form fields
    document.getElementById('name').value = data.name || '';
    document.getElementById('email').value = data.email || '';
    document.getElementById('phone').value = data.phone || '';
    document.getElementById('birth_date').value = data.birth_date?.split('T')[0] || '';
    document.getElementById('address').value = data.address || '';
    document.getElementById('bio').value = data.bio || '';
    document.getElementById('emergency_contact').value = data.emergency_contact || '';
    document.getElementById('emergency_phone').value = data.emergency_phone || '';

    // Work info
    document.getElementById('employeeCode').textContent = data.employee_code || '-';
    document.getElementById('hireDate').textContent = data.hire_date ?
      new Date(data.hire_date).toLocaleDateString('id-ID') : '-';
    document.getElementById('employeeStatus').textContent = data.status === 'ACTIVE' ? 'Aktif' : 'Tidak Aktif';
    document.getElementById('employeeStatus').className = `text-xl font-bold ${data.status === 'ACTIVE' ? 'text-green-600' : 'text-gray-600'}`;
  }

  async function loadLeaveHistory() {
    const historyContainer = document.getElementById('leaveHistory');

    if (!currentUser?.employee_id) {
      historyContainer.innerHTML = '<p class="text-gray-500 text-center py-4">Data tidak tersedia</p>';
      return;
    }

    try {
      const response = await fetch(`${API_BASE}/employees/leave-requests/all?employee_id=${currentUser.employee_id}`);
      const result = await response.json();

      if (result.success && result.data && result.data.length > 0) {
        historyContainer.innerHTML = result.data.map(req => `
          <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
            <div>
              <p class="font-medium text-gray-900">${getLeaveTypeLabel(req.leave_type)}</p>
              <p class="text-sm text-gray-600">
                ${new Date(req.start_date).toLocaleDateString('id-ID')} - ${new Date(req.end_date).toLocaleDateString('id-ID')}
              </p>
              <p class="text-sm text-gray-500">${req.reason || '-'}</p>
            </div>
            <span class="px-3 py-1 text-sm font-semibold rounded-full ${getStatusColor(req.status)}">
              ${getStatusLabel(req.status)}
            </span>
          </div>
        `).join('');
      } else {
        historyContainer.innerHTML = '<p class="text-gray-500 text-center py-4">Belum ada riwayat pengajuan</p>';
      }
    } catch (error) {
      console.error('Error loading leave history:', error);
      historyContainer.innerHTML = '<p class="text-red-500 text-center py-4">Gagal memuat riwayat</p>';
    }
  }

  function getLeaveTypeLabel(type) {
    const labels = {
      'SICK': 'Sakit',
      'ANNUAL': 'Cuti Tahunan',
      'PERSONAL': 'Keperluan Pribadi',
      'OTHER': 'Lainnya'
    };
    return labels[type] || type;
  }

  function getStatusLabel(status) {
    const labels = {
      'PENDING': 'Menunggu',
      'APPROVED': 'Disetujui',
      'REJECTED': 'Ditolak'
    };
    return labels[status] || status;
  }

  function getStatusColor(status) {
    switch (status) {
      case 'APPROVED': return 'bg-green-100 text-green-800';
      case 'REJECTED': return 'bg-red-100 text-red-800';
      default: return 'bg-yellow-100 text-yellow-800';
    }
  }

  function showError(message) {
    const profileLoading = document.getElementById('profileLoading');
    profileLoading.innerHTML = `<p class="text-red-500">${message}</p>`;
  }

  // Profile form submit
  document.getElementById('profileForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!currentUser?.employee_id) {
      alert('Data karyawan tidak tersedia');
      return;
    }

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch(`${API_BASE}/employees/${currentUser.employee_id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...employeeData,
          ...data
        })
      });

      const result = await response.json();

      if (result.success) {
        alert('Profil berhasil diperbarui!');
        await loadEmployeeData();
      } else {
        alert('Gagal memperbarui profil: ' + (result.error || 'Unknown error'));
      }
    } catch (error) {
      console.error('Error updating profile:', error);
      alert('Terjadi kesalahan saat memperbarui profil');
    }
  });

  // Leave form submit
  document.getElementById('leaveForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!currentUser?.employee_id) {
      alert('Data karyawan tidak tersedia');
      return;
    }

    const formData = new FormData(e.target);
    const data = {
      employee_id: currentUser.employee_id,
      leave_type: formData.get('leave_type'),
      start_date: formData.get('start_date'),
      end_date: formData.get('end_date'),
      reason: formData.get('reason')
    };

    try {
      const response = await fetch(`${API_BASE}/employees/leave-requests`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (result.success) {
        alert('Pengajuan izin berhasil dikirim!');
        e.target.reset();
        await loadLeaveHistory();
      } else {
        alert('Gagal mengajukan izin: ' + (result.error || 'Unknown error'));
      }
    } catch (error) {
      console.error('Error submitting leave request:', error);
      alert('Terjadi kesalahan saat mengajukan izin');
    }
  });
</script>
