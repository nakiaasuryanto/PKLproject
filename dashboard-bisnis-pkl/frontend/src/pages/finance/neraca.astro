---
import MainLayout from '../../layouts/MainLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { api } from '../../lib/api';

const dashboardResponse = await api.get('/dashboard/overview');
const transactionsResponse = await api.get('/transactions?limit=500');

const dashboard = dashboardResponse.success ? dashboardResponse.data : {};
const transactions = (transactionsResponse.success && Array.isArray(transactionsResponse.data)) ? transactionsResponse.data : [];

const totalSales = Math.round(Number(dashboard.sales?.total_sales) || 0);
const totalExpenses = Math.round(Number(dashboard.expenses?.total) || 0);
const totalStock = dashboard.inventory?.total_stock || 0;
const stockValue = totalStock * 50000;

const totalReceivables = transactions
  .filter((t: any) => t.transaction_type === 'INVOICE' && t.payment_status !== 'PAID')
  .reduce((sum: number, t: any) => sum + (Number(t.total_amount) || 0), 0);

const totalPayables = Math.round(totalExpenses * 0.1);

const kas = totalSales - totalExpenses;
const totalAktiva = kas + stockValue + Math.round(totalReceivables);
const totalPasiva = totalPayables;
const modal = totalAktiva - totalPasiva;

function formatCurrency(amount: number): string {
  return `Rp ${Math.round(amount).toLocaleString('id-ID')}`;
}

const currentDate = new Date().toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<MainLayout title="Neraca - Keuangan" activeModule="finance">
  <div class="mb-8">
    <div class="flex items-center space-x-2 text-sm text-gray-600 mb-2">
      <a href="/finance" class="hover:text-finance-600">Keuangan</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Neraca</span>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Neraca (Balance Sheet)</h1>
        <p class="mt-2 text-gray-600">Per tanggal {currentDate}</p>
      </div>
      <div class="mt-4 sm:mt-0 flex gap-2">
        <Button href="/finance" variant="outline" color="finance" size="md">
          ← Kembali
        </Button>
        <button onclick="window.print()" class="px-4 py-2 bg-finance-500 text-white rounded-lg hover:bg-finance-600 transition-colors">
          🖨️ Cetak
        </button>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 print:shadow-none print:border-0">
    <div class="text-center mb-8 print:mb-4">
      <h2 class="text-xl font-bold text-gray-900">NERACA</h2>
      <p class="text-gray-600">Per {currentDate}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- AKTIVA -->
      <div>
        <h3 class="text-lg font-bold text-gray-900 border-b-2 border-finance-500 pb-2 mb-4">AKTIVA</h3>

        <div class="space-y-4">
          <div>
            <h4 class="font-semibold text-gray-700 mb-2">Aktiva Lancar</h4>
            <div class="space-y-2 pl-4">
              <div class="flex justify-between">
                <span class="text-gray-600">Kas</span>
                <span class="font-mono">{formatCurrency(kas)}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Piutang Usaha</span>
                <span class="font-mono">{formatCurrency(totalReceivables)}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Persediaan</span>
                <span class="font-mono">{formatCurrency(stockValue)}</span>
              </div>
              <div class="flex justify-between border-t pt-2 font-semibold">
                <span>Total Aktiva Lancar</span>
                <span class="font-mono">{formatCurrency(kas + totalReceivables + stockValue)}</span>
              </div>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-gray-700 mb-2">Aktiva Tetap</h4>
            <div class="space-y-2 pl-4">
              <div class="flex justify-between">
                <span class="text-gray-600">Peralatan</span>
                <span class="font-mono">Rp 0</span>
              </div>
              <div class="flex justify-between border-t pt-2 font-semibold">
                <span>Total Aktiva Tetap</span>
                <span class="font-mono">Rp 0</span>
              </div>
            </div>
          </div>

          <div class="border-t-2 border-gray-300 pt-4">
            <div class="flex justify-between text-lg font-bold text-finance-700">
              <span>TOTAL AKTIVA</span>
              <span class="font-mono">{formatCurrency(totalAktiva)}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- PASIVA -->
      <div>
        <h3 class="text-lg font-bold text-gray-900 border-b-2 border-finance-500 pb-2 mb-4">PASIVA</h3>

        <div class="space-y-4">
          <div>
            <h4 class="font-semibold text-gray-700 mb-2">Kewajiban Lancar</h4>
            <div class="space-y-2 pl-4">
              <div class="flex justify-between">
                <span class="text-gray-600">Utang Usaha</span>
                <span class="font-mono">{formatCurrency(totalPayables)}</span>
              </div>
              <div class="flex justify-between border-t pt-2 font-semibold">
                <span>Total Kewajiban Lancar</span>
                <span class="font-mono">{formatCurrency(totalPayables)}</span>
              </div>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-gray-700 mb-2">Kewajiban Jangka Panjang</h4>
            <div class="space-y-2 pl-4">
              <div class="flex justify-between">
                <span class="text-gray-600">Utang Bank</span>
                <span class="font-mono">Rp 0</span>
              </div>
              <div class="flex justify-between border-t pt-2 font-semibold">
                <span>Total Kewajiban Jk. Panjang</span>
                <span class="font-mono">Rp 0</span>
              </div>
            </div>
          </div>

          <div>
            <h4 class="font-semibold text-gray-700 mb-2">Ekuitas</h4>
            <div class="space-y-2 pl-4">
              <div class="flex justify-between">
                <span class="text-gray-600">Modal</span>
                <span class="font-mono">{formatCurrency(modal)}</span>
              </div>
              <div class="flex justify-between border-t pt-2 font-semibold">
                <span>Total Ekuitas</span>
                <span class="font-mono">{formatCurrency(modal)}</span>
              </div>
            </div>
          </div>

          <div class="border-t-2 border-gray-300 pt-4">
            <div class="flex justify-between text-lg font-bold text-finance-700">
              <span>TOTAL PASIVA</span>
              <span class="font-mono">{formatCurrency(totalAktiva)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-4 border-t text-center text-sm text-gray-500">
      <p>Laporan ini dihasilkan secara otomatis dari sistem Dashboard Bisnis</p>
    </div>
  </div>
</MainLayout>

<style>
  @media print {
    body { background: white; }
    .no-print { display: none !important; }
  }
</style>
