---
import MainLayout from '../../layouts/MainLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { api } from '../../lib/api';

const employeesData = await api.get('/employees');
const employees = (employeesData?.success && Array.isArray(employeesData?.data)) ? employeesData.data : [];

const departments = [...new Set(employees.map((e: any) => e.department))];
---

<MainLayout title="Semua Karyawan - HR" activeModule="hr">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Semua Karyawan</h1>
      <p class="mt-2 text-gray-600">Daftar lengkap semua karyawan</p>
    </div>
    <div class="mt-4 sm:mt-0 flex gap-3">
      <Button variant="outline" color="hr" size="md" href="/hr">
        ← Kembali
      </Button>
      <Button variant="primary" color="hr" size="md" href="/hr/new-employee">
        + Tambah Karyawan
      </Button>
    </div>
  </div>

  <Card title={`Total ${employees.length} Karyawan`} color="hr">
    <div class="mb-6 flex flex-col md:flex-row gap-4">
      <div class="flex-1">
        <input
          type="text"
          id="searchInput"
          placeholder="Cari nama karyawan..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-hr-500 focus:border-hr-500"
        />
      </div>
      <select id="deptFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-hr-500">
        <option value="">Semua Departemen</option>
        {departments.map((dept: any) => (
          <option value={dept}>{dept}</option>
        ))}
      </select>
      <select id="statusFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-hr-500">
        <option value="">Semua Status</option>
        <option value="ACTIVE">Aktif</option>
        <option value="INACTIVE">Tidak Aktif</option>
      </select>
    </div>

    <div class="overflow-x-auto max-h-[600px] overflow-y-auto">
      <table class="min-w-full divide-y divide-gray-200" id="employeesTable">
        <thead class="bg-hr-50 sticky top-0">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-hr-700 uppercase">Kode</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-hr-700 uppercase">Nama</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-hr-700 uppercase">Posisi</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-hr-700 uppercase">Departemen</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-hr-700 uppercase">Kontak</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-hr-700 uppercase">Bergabung</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-hr-700 uppercase">Status</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-hr-700 uppercase">Aksi</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" id="tableBody">
          {employees.length > 0 ? employees.map((emp: any) => (
            <tr class="hover:bg-hr-50 employee-row"
                data-name={emp.name.toLowerCase()}
                data-dept={emp.department}
                data-status={emp.status}>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">
                {emp.employee_code}
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="w-10 h-10 bg-hr-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-semibold text-hr-600">
                      {emp.name.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
                    </span>
                  </div>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900">{emp.name}</p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-900">{emp.position}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="px-2 py-1 text-xs font-medium rounded-full bg-hr-100 text-hr-800">
                  {emp.department}
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600">
                <div>
                  <p>{emp.phone || '-'}</p>
                  <p class="text-xs text-gray-500">{emp.email || '-'}</p>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
                {new Date(emp.hire_date).toLocaleDateString('id-ID')}
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class={`px-2 py-1 text-xs font-semibold rounded-full ${
                  emp.status === 'ACTIVE'
                    ? 'bg-green-100 text-green-800'
                    : 'bg-gray-100 text-gray-800'
                }`}>
                  {emp.status === 'ACTIVE' ? 'Aktif' : 'Tidak Aktif'}
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-center">
                <a href={`/hr/employee/${emp.id}`} class="text-hr-600 hover:text-hr-700 font-medium text-sm">
                  Detail
                </a>
              </td>
            </tr>
          )) : (
            <tr>
              <td colspan="8" class="px-4 py-8 text-center text-gray-500">
                Belum ada data karyawan
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex justify-between items-center text-sm text-gray-500 pt-4 border-t">
      <span id="resultCount">Menampilkan {employees.length} karyawan</span>
    </div>
  </Card>
</MainLayout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const deptFilter = document.getElementById('deptFilter') as HTMLSelectElement;
  const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
  const rows = document.querySelectorAll('.employee-row');
  const resultCount = document.getElementById('resultCount');

  function filterRows() {
    const searchTerm = searchInput?.value.toLowerCase() || '';
    const deptValue = deptFilter?.value || '';
    const statusValue = statusFilter?.value || '';

    let visibleCount = 0;

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const dept = row.getAttribute('data-dept') || '';
      const status = row.getAttribute('data-status') || '';

      const matchesSearch = name.includes(searchTerm);
      const matchesDept = !deptValue || dept === deptValue;
      const matchesStatus = !statusValue || status === statusValue;

      if (matchesSearch && matchesDept && matchesStatus) {
        (row as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });

    if (resultCount) {
      resultCount.textContent = `Menampilkan ${visibleCount} karyawan`;
    }
  }

  searchInput?.addEventListener('input', filterRows);
  deptFilter?.addEventListener('change', filterRows);
  statusFilter?.addEventListener('change', filterRows);
</script>
