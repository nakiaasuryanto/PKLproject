---
import MainLayout from '../layouts/MainLayout.astro';
import Card from '../components/ui/Card.astro';
import StatCard from '../components/ui/StatCard.astro';
import Button from '../components/ui/Button.astro';
---

<MainLayout title="Prospecting - Dashboard Bisnis" activeModule="crm">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Prospecting Management</h1>
      <p class="mt-2 text-gray-600">Kelola prospecting (VG-style) dan pembayaran Virtual Account BCA</p>
    </div>
    <div class="mt-4 sm:mt-0 flex gap-3">
      <span id="lastUpdate" class="text-sm text-gray-500 self-center"></span>
      <Button variant="primary" color="crm" size="lg" id="addProspectingBtn">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Tambah Prospecting
      </Button>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
    <StatCard
      title="Total Prospecting"
      value="-"
      change="Semua status"
      changeType="neutral"
      color="crm"
      icon="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
      id="statTotal"
    />
    <StatCard
      title="Closing"
      value="-"
      change="Menunggu pembayaran"
      changeType="neutral"
      color="crm"
      icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
      id="statClosing"
    />
    <StatCard
      title="Closed (Paid)"
      value="-"
      change="Sudah dibayar"
      changeType="positive"
      color="crm"
      icon="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
      id="statClosed"
    />
    <StatCard
      title="Total Revenue"
      value="-"
      change="Dari VA yang dibayar"
      changeType="positive"
      color="crm"
      icon="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
      id="statRevenue"
    />
  </div>

  <!-- Auto-refresh indicator -->
  <div class="mb-4 flex items-center gap-3">
    <div class="flex items-center gap-2">
      <span id="refreshIndicator" class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
      <span class="text-sm text-gray-500">Auto-refresh setiap 5 detik</span>
    </div>
    <button
      id="refreshBtn"
      class="px-3 py-1 text-sm bg-crm-100 text-crm-700 rounded-lg hover:bg-crm-200 transition"
    >
      Refresh Sekarang
    </button>
  </div>

  <!-- Prospecting List -->
  <Card title="Daftar Prospecting" color="crm">
    <!-- Search and Filter -->
    <div class="mb-6 flex flex-col md:flex-row gap-4">
      <div class="flex-1">
        <input
          type="text"
          id="searchInput"
          placeholder="Cari nama kontak atau instansi..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crm-500 focus:border-crm-500"
        />
      </div>
      <select id="statusFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crm-500">
        <option value="">Semua Status</option>
        <option value="New">New</option>
        <option value="Follow Up">Follow Up</option>
        <option value="Closing">Closing</option>
        <option value="Closed">Closed</option>
        <option value="Lost">Lost</option>
      </select>
      <select id="vaFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-crm-500">
        <option value="">Semua VA</option>
        <option value="ACTIVE">VA Active</option>
        <option value="PAID">VA Paid</option>
        <option value="none">Belum Ada VA</option>
      </select>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto max-h-[500px] overflow-y-auto">
      <table class="min-w-full divide-y divide-gray-200" id="prospectingsTable">
        <thead class="bg-crm-50 sticky top-0">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">Kontak</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">Instansi</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">Produk</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-crm-700 uppercase">Omzet</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-crm-700 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-crm-700 uppercase">VA Number</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-crm-700 uppercase">Aksi</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" id="tableBody">
          <tr>
            <td colspan="9" class="px-4 py-8 text-center text-gray-500">
              Loading...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex justify-between items-center text-sm text-gray-500 pt-4 border-t">
      <span id="resultCount">Menampilkan 0 prospecting</span>
    </div>
  </Card>

  <!-- Legend -->
  <div class="mt-6 p-4 bg-gray-50 rounded-lg">
    <h3 class="font-semibold text-gray-700 mb-2">Status Legend (VG-style):</h3>
    <div class="flex flex-wrap gap-4 text-sm">
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-blue-100 text-blue-800">New</span>
        <span class="text-gray-500">Prospecting baru</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-purple-100 text-purple-800">Follow Up</span>
        <span class="text-gray-500">Sedang follow up</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-yellow-100 text-yellow-800">Closing</span>
        <span class="text-gray-500">Menunggu pembayaran VA</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-green-100 text-green-800">Closed</span>
        <span class="text-gray-500">Sudah dibayar (auto dari BCA)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 rounded-full bg-red-100 text-red-800">Lost</span>
        <span class="text-gray-500">Prospecting gagal</span>
      </div>
    </div>
  </div>
</MainLayout>

<!-- Add Prospecting Modal (VG Structure) -->
<div id="addModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <div class="p-6 border-b">
      <h2 class="text-xl font-bold text-gray-900">Tambah Prospecting Baru</h2>
      <p class="text-sm text-gray-500 mt-1">Struktur VG: Instansi → Kontak → Prospecting</p>
    </div>
    <form id="addForm" class="p-6 space-y-6">
      <!-- Instansi Section -->
      <div class="border-b pb-4">
        <h3 class="font-semibold text-gray-700 mb-3">Data Instansi (Perusahaan)</h3>
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Instansi</label>
            <input type="text" name="instansi_nama" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" placeholder="PT/CV/UD..." />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Jenis Instansi</label>
            <select name="instansi_jenis" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500">
              <option value="">-- Pilih --</option>
              <option value="Sekolah">Sekolah</option>
              <option value="Universitas">Universitas</option>
              <option value="Perusahaan">Perusahaan</option>
              <option value="Instansi Pemerintah">Instansi Pemerintah</option>
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Unit Bisnis</label>
            <input type="text" name="unit_bisnis" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" />
          </div>
        </div>
      </div>

      <!-- Kontak Section -->
      <div class="border-b pb-4">
        <h3 class="font-semibold text-gray-700 mb-3">Data Kontak (PIC)</h3>
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Kontak *</label>
            <input type="text" name="kontak_nama" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Telepon</label>
            <input type="text" name="kontak_telepon" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" placeholder="08xxx" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="kontak_email" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" />
          </div>
        </div>
      </div>

      <!-- Prospecting Section -->
      <div>
        <h3 class="font-semibold text-gray-700 mb-3">Data Prospecting</h3>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Produk</label>
            <input type="text" name="produk" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" placeholder="Nama produk" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Bahan</label>
            <input type="text" name="bahan" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" placeholder="Bahan produk" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Jumlah</label>
            <input type="number" name="jumlah" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" placeholder="Qty" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Harga Satuan (Rp)</label>
            <input type="number" name="harga_satuan" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500" placeholder="0" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Saluran</label>
            <select name="saluran" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500">
              <option value="">-- Pilih --</option>
              <option value="Website">Website</option>
              <option value="WhatsApp">WhatsApp</option>
              <option value="Telepon">Telepon</option>
              <option value="Email">Email</option>
              <option value="Referral">Referral</option>
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select name="status" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-crm-500">
              <option value="New">New</option>
              <option value="Follow Up">Follow Up</option>
              <option value="Closing">Closing (siap generate VA)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t">
        <button type="button" id="cancelAddBtn" class="px-4 py-2 border rounded-lg hover:bg-gray-50">Batal</button>
        <button type="submit" class="px-4 py-2 bg-crm-600 text-white rounded-lg hover:bg-crm-700">Simpan</button>
      </div>
    </form>
  </div>
</div>


<script is:inline>
  // Use production API URLs
  const API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:3001'
    : 'https://pklproject-backend.up.railway.app';

  let prospectingsData = [];

  // Format currency
  function formatCurrency(amount) {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0
    }).format(amount);
  }

  // Get status badge class (VG-style statuses)
  function getStatusBadge(status) {
    switch (status) {
      case 'New':
        return 'bg-blue-100 text-blue-800';
      case 'Follow Up':
        return 'bg-purple-100 text-purple-800';
      case 'Closing':
        return 'bg-yellow-100 text-yellow-800';
      case 'Closed':
        return 'bg-green-100 text-green-800';
      case 'Lost':
        return 'bg-red-100 text-red-800';
      default:
        return 'bg-gray-100 text-gray-800';
    }
  }

  // Get VA status badge class
  function getVaStatusBadge(status) {
    switch (status) {
      case 'ACTIVE':
        return 'bg-blue-100 text-blue-800';
      case 'PAID':
        return 'bg-emerald-100 text-emerald-800';
      default:
        return 'bg-gray-50 text-gray-400';
    }
  }

  // Render table (VG structure)
  function renderTable(data) {
    const tableBody = document.getElementById('tableBody');
    const resultCount = document.getElementById('resultCount');

    if (!tableBody) return;

    if (data.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="9" class="px-4 py-8 text-center text-gray-500">
            Tidak ada data prospecting
          </td>
        </tr>
      `;
      if (resultCount) resultCount.textContent = 'Menampilkan 0 prospecting';
      return;
    }

    tableBody.innerHTML = data.map(p => `
      <tr class="hover:bg-crm-50 transition-colors"
          data-id="${p.id}"
          data-name="${(p.kontak_nama || '').toLowerCase()}"
          data-status="${p.status || ''}"
          data-va-status="${p.va_status || 'none'}">
        <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-900">
          #${p.id}
        </td>
        <td class="px-4 py-3 text-sm text-gray-900">
          <div>
            <p class="font-semibold">${p.kontak_nama || '-'}</p>
            <p class="text-xs text-gray-500">${p.kontak_telepon || '-'}</p>
          </div>
        </td>
        <td class="px-4 py-3 text-sm text-gray-600">
          <div>
            <p>${p.instansi_nama || '-'}</p>
            <p class="text-xs text-gray-400">${p.unit_bisnis || ''}</p>
          </div>
        </td>
        <td class="px-4 py-3 text-sm text-gray-600">
          <div>
            <p>${p.produk || '-'}</p>
            <p class="text-xs text-gray-400">${p.bahan || ''}</p>
          </div>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-sm text-right font-semibold text-gray-900">
          ${p.transaction_amount ? `
            <span class="text-green-600">${formatCurrency(parseFloat(p.transaction_amount))}</span>
            <p class="text-xs text-gray-400">Invoice</p>
          ` : p.omzet ? `
            <span>${formatCurrency(parseFloat(p.omzet))}</span>
            <p class="text-xs text-gray-400">Estimasi</p>
          ` : '-'}
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-center">
          <span class="px-2 py-1 text-xs font-semibold rounded-full ${getStatusBadge(p.status)}">
            ${p.status || '-'}
          </span>
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-sm">
          ${p.va_number ? `
            <span class="font-mono text-gray-600">${p.va_number}</span>
            <span class="ml-1 px-1.5 py-0.5 text-xs rounded ${getVaStatusBadge(p.va_status)}">${p.va_status || ''}</span>
          ` : '<span class="text-gray-400">-</span>'}
        </td>
        <td class="px-4 py-3 whitespace-nowrap text-center">
          ${!p.va_number ? `
            <a href="/sales/invoice/new?customer=${encodeURIComponent(p.kontak_nama || '')}&phone=${encodeURIComponent(p.kontak_telepon || '')}&amount=${p.omzet || 0}"
               class="px-3 py-1 text-xs bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 inline-block">
              Buat Invoice
            </a>
          ` : p.va_status === 'ACTIVE' ? `
            <a href="/sales" class="text-xs text-yellow-600 hover:underline">Menunggu Bayar →</a>
          ` : p.va_status === 'PAID' ? `
            <a href="/sales" class="text-xs text-green-600 hover:underline">✓ Lunas →</a>
          ` : ''}
        </td>
      </tr>
    `).join('');

    if (resultCount) {
      resultCount.textContent = `Menampilkan ${data.length} prospecting`;
    }

  }

  // Update stats
  function updateStats(stats) {
    const p = stats.prospecting || {};
    const va = stats.va || {};

    const statTotal = document.querySelector('#statTotal .text-2xl, #statTotal .text-3xl');
    const statClosing = document.querySelector('#statClosing .text-2xl, #statClosing .text-3xl');
    const statClosed = document.querySelector('#statClosed .text-2xl, #statClosed .text-3xl');
    const statRevenue = document.querySelector('#statRevenue .text-2xl, #statRevenue .text-3xl');

    if (statTotal) statTotal.textContent = p.total || '0';
    if (statClosing) statClosing.textContent = p.closing || '0';
    if (statClosed) statClosed.textContent = p.closed || '0';
    if (statRevenue) statRevenue.textContent = formatCurrency(parseFloat(va.total_revenue) || 0);
  }

  // Filter rows
  function filterRows() {
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const vaFilter = document.getElementById('vaFilter');

    const searchTerm = searchInput?.value.toLowerCase() || '';
    const statusValue = statusFilter?.value || '';
    const vaValue = vaFilter?.value || '';

    const filtered = prospectingsData.filter(p => {
      const matchesSearch = !searchTerm ||
        (p.kontak_nama || '').toLowerCase().includes(searchTerm) ||
        (p.instansi_nama || '').toLowerCase().includes(searchTerm);
      const matchesStatus = !statusValue || p.status === statusValue;
      const matchesVa = !vaValue ||
        (vaValue === 'none' && !p.va_status) ||
        (vaValue !== 'none' && p.va_status === vaValue);

      return matchesSearch && matchesStatus && matchesVa;
    });

    renderTable(filtered);
  }

  // Fetch data
  async function fetchData() {
    try {
      const response = await fetch(`${API_BASE}/prospectings`);
      const result = await response.json();

      if (result.success) {
        prospectingsData = result.data;
        filterRows();
      }

      const statsResponse = await fetch(`${API_BASE}/prospectings/stats`);
      const statsResult = await statsResponse.json();

      if (statsResult.success) {
        updateStats(statsResult.data);
      }

      const lastUpdate = document.getElementById('lastUpdate');
      if (lastUpdate) {
        lastUpdate.textContent = `Updated: ${new Date().toLocaleTimeString('id-ID')}`;
      }
    } catch (err) {
      console.error('Failed to fetch data:', err);
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    fetchData();
    setInterval(fetchData, 5000);

    // Refresh button
    document.getElementById('refreshBtn')?.addEventListener('click', fetchData);

    // Filter listeners
    document.getElementById('searchInput')?.addEventListener('input', filterRows);
    document.getElementById('statusFilter')?.addEventListener('change', filterRows);
    document.getElementById('vaFilter')?.addEventListener('change', filterRows);

    // Add Prospecting Modal
    const addModal = document.getElementById('addModal');
    document.getElementById('addProspectingBtn')?.addEventListener('click', () => {
      addModal?.classList.remove('hidden');
    });
    document.getElementById('cancelAddBtn')?.addEventListener('click', () => {
      addModal?.classList.add('hidden');
    });

    // Add Form Submit
    document.getElementById('addForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const data = {};
      formData.forEach((value, key) => {
        data[key] = value;
      });

      try {
        await fetch(`${API_BASE}/prospectings`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        form.reset();
        addModal?.classList.add('hidden');
        await fetchData();
      } catch (err) {
        console.error('Failed to add prospecting:', err);
      }
    });

  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; background-color: #fef3c7; }
    to { opacity: 1; background-color: transparent; }
  }
</style>
