# ============================================
# Frontend Environment Variables
# ============================================

# Backend API URL
# For local development
PUBLIC_API_URL=http://localhost:3001/api

# For production (set in Railway dashboard)
# PUBLIC_API_URL=https://your-backend.up.railway.app/api

# Site URL for share links
# For local development
PUBLIC_SITE_URL=http://localhost:4321

# For production (set in Railway dashboard)
# PUBLIC_SITE_URL=https://your-frontend.up.railway.app

# Port (Railway will override this automatically)
PORT=4321
